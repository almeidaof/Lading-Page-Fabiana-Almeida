<script>
// ===== JavaScript da página =====
(function () {
  "use strict";

  // 1) Rolagem suave ao clicar nos links do menu (Sobre, Atendimentos, Contato)
  document.querySelectorAll('a[href^="#"]').forEach(function (link) {
    link.addEventListener("click", function (e) {
      var alvo = document.querySelector(link.getAttribute("href"));
      if (alvo) {
        e.preventDefault();
        alvo.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
  });

  // 2) Animação de aparecimento suave das seções ao rolar a página
  var secoes = document.querySelectorAll(".sobre, .servicos, .quote, .contato, .card, .service");
  secoes.forEach(function (el) {
    el.style.opacity = "0";
    el.style.transform = "translateY(24px)";
    el.style.transition = "opacity .7s ease, transform .7s ease";
  });
  var observer = new IntersectionObserver(function (entradas) {
    entradas.forEach(function (entrada) {
      if (entrada.isIntersecting) {
        entrada.target.style.opacity = "1";
        entrada.target.style.transform = "translateY(0)";
        observer.unobserve(entrada.target);
      }
    });
  }, { threshold: 0.15 });
  secoes.forEach(function (el) { observer.observe(el); });

  // 3) Ano atual automático no rodapé
  var rodape = document.querySelector("footer");
  if (rodape) {
    rodape.textContent = "Fabiana Almeida — Especialista em Neurociência · " + new Date().getFullYear();
  }
})();
</script>
