<style>
  :root {
    --radius: 1rem;
    --background: oklch(0.975 0.012 75);
    --foreground: oklch(0.27 0.03 40);
    --card: oklch(0.99 0.008 75);
    --primary: oklch(0.6 0.12 40);
    --primary-foreground: oklch(0.98 0.01 75);
    --secondary: oklch(0.9 0.035 140);
    --secondary-foreground: oklch(0.32 0.05 145);
    --muted: oklch(0.94 0.018 75);
    --muted-foreground: oklch(0.5 0.03 45);
    --accent: oklch(0.55 0.06 145);
    --accent-foreground: oklch(0.98 0.01 75);
    --border: oklch(0.88 0.02 70);
    --gold: oklch(0.66 0.13 78);
    --font-display: "Fraunces", Georgia, serif;
    --font-sans: "Nunito Sans", system-ui, sans-serif;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    background-color: var(--background);
    color: var(--foreground);
    font-family: var(--font-sans);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3 {
    font-family: var(--font-display);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .wrap { max-width: 72rem; margin: 0 auto; padding: 0 1.5rem; }
  .wrap-narrow { max-width: 48rem; margin: 0 auto; padding: 0 1.5rem; }

  /* ---------- header ---------- */
  .site-header {
    display: none;
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem;
    justify-content: flex-end;
    align-items: center;
  }
  @media (min-width: 768px) { .site-header { display: flex; } }
  .site-header nav { display: flex; gap: 2rem; }
  .site-header a {
    color: var(--muted-foreground);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color .2s ease;
  }
  .site-header a:hover { color: var(--primary); }

  /* ---------- hero ---------- */
  .hero { max-width: 56rem; margin: 0 auto; padding: 2.5rem 1.5rem 5rem; text-align: center; }
  .eyebrow {
    margin-bottom: 1rem;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent);
  }
  .hero h1 {
    font-size: 3rem;
    font-weight: 600;
    color: var(--gold);
  }
  @media (min-width: 768px) { .hero h1 { font-size: 4.5rem; } }
  .tagline {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.5rem;
    color: var(--primary);
  }
  @media (min-width: 768px) { .tagline { font-size: 1.875rem; } }
  .lede {
    margin: 1.25rem auto 0;
    max-width: 36rem;
    font-size: 1.125rem;
    color: var(--muted-foreground);
  }
  .hero-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .btn {
    display: inline-block;
    border-radius: 9999px;
    padding: 0.75rem 1.75rem;
    font-weight: 700;
    text-decoration: none;
    transition: opacity .2s ease, background-color .2s ease;
  }
  .btn-primary {
    background-color: var(--primary);
    color: var(--primary-foreground);
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
  }
  .btn-primary:hover { opacity: 0.9; }
  .btn-outline {
    border: 1px solid var(--border);
    color: var(--foreground);
    background: transparent;
  }
  .btn-outline:hover { background-color: var(--muted); }

  .photo {
    position: relative;
    max-width: 24rem;
    margin: 3.5rem auto 0;
  }
  .photo::before {
    content: "";
    position: absolute;
    inset: -0.75rem;
    transform: rotate(-3deg);
    border-radius: 2rem;
    background-color: var(--secondary);
  }
  .photo img {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 2rem;
  }

  /* ---------- sobre ---------- */
  .sobre { background-color: var(--card); padding: 5rem 0; }
  .sobre h2, .servicos h2, .contato h2 { font-size: 2.25rem; font-weight: 600; }
  .sobre h2 { max-width: 42rem; }
  .grid-journey {
    margin-top: 3rem;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .grid-journey { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid-journey { grid-template-columns: repeat(4, 1fr); } }
  .card {
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.5rem;
    background: transparent;
  }
  .card .num { font-family: var(--font-display); font-size: 1.875rem; color: var(--primary); }
  .card h3 { margin-top: 0.75rem; font-size: 1.25rem; font-weight: 600; }
  .card p { margin-top: 0.5rem; font-size: 0.875rem; color: var(--muted-foreground); }

  /* ---------- atendimentos ---------- */
  .servicos { max-width: 72rem; margin: 0 auto; padding: 5rem 1.5rem; }
  .grid-services { margin-top: 2.5rem; display: grid; gap: 1.5rem; grid-template-columns: 1fr; }
  @media (min-width: 768px) { .grid-services { grid-template-columns: repeat(2, 1fr); } }
  .service {
    background-color: var(--secondary);
    color: var(--secondary-foreground);
    border-radius: 1rem;
    padding: 2rem;
  }
  .service h3 { font-size: 1.5rem; font-weight: 600; }
  .service p { margin-top: 0.75rem; opacity: 0.8; }

  /* ---------- citação ---------- */
  .quote { background-color: var(--accent); color: var(--accent-foreground); padding: 5rem 0; }
  .quote blockquote {
    max-width: 48rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.875rem;
    line-height: 1.35;
  }
  @media (min-width: 768px) { .quote blockquote { font-size: 2.25rem; } }

  /* ---------- contato ---------- */
  .contato { max-width: 48rem; margin: 0 auto; padding: 6rem 1.5rem; text-align: center; }
  .contato p { margin-top: 1rem; color: var(--muted-foreground); }
  .btn-big { margin-top: 2rem; padding: 1rem 2rem; font-size: 1rem; }
  .phone { margin-top: 1rem; font-size: 0.875rem; color: var(--muted-foreground); }

  footer {
    border-top: 1px solid var(--border);
    padding: 2rem 1.5rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
</style>
